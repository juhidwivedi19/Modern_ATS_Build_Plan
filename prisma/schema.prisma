generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique
  name                     String
  password                 String
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  emailVerificationExpires DateTime?
  emailVerificationToken   String?
  emailVerified            Boolean   @default(false)
  resetPasswordExpires     DateTime?
  resetPasswordToken       String?

  jobs                  Job[]
  organizationMembers   OrganizationMember[]
  refreshTokens         RefreshToken[]
  candidate             Candidate?
  activityLogs          ActivityLog[]
  notifications         Notification[]
  createdInterviews     Interview[]            @relation("InterviewCreatedBy")
  interviewAssignments  InterviewInterviewer[]
  googleCalendarAccount GoogleCalendarAccount?

  interviewEvaluationNotes           InterviewEvaluationNote[]
  interviewEvaluationComments        InterviewEvaluationComment[]
  interviewEvaluationCommentMentions InterviewEvaluationCommentMention[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String
  userId     Int
  expiresAt  DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companySize String?
  description String?
  industry    String?
  location    String?
  logo        String?
  website     String?
  slug        String   @unique

  departments Department[]
  invitations Invitation[]
  jobs        Job[]
  members     OrganizationMember[]
}

model OrganizationMember {
  id             Int              @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Invitation {
  id             Int              @id @default(autoincrement())
  email          String
  organizationId Int
  role           OrganizationRole @default(MEMBER)
  token          String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Department {
  id             Int      @id @default(autoincrement())
  name           String
  organizationId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]

  @@unique([name, organizationId])
}

model RolePermission {
  id         Int              @id @default(autoincrement())
  role       OrganizationRole
  permission Permission

  @@unique([role, permission])
}

model Job {
  id             Int       @id @default(autoincrement())
  title          String
  description    String
  location       String
  salary         Float?
  employmentType String
  requiredSkills String?
  experience     Int?
  status         JobStatus @default(DRAFT)

  organizationId Int
  departmentId   Int
  createdById    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User         @relation(fields: [createdById], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  applications Application[]
}

enum OrganizationRole {
  OWNER
  MEMBER
  ADMIN
  RECRUITER
  INTERVIEWER
}

enum Permission {
  ORGANIZATION_VIEW
  ORGANIZATION_UPDATE
  ORGANIZATION_DELETE

  MEMBER_VIEW
  MEMBER_INVITE
  MEMBER_REMOVE
  MEMBER_ROLE_UPDATE

  DEPARTMENT_VIEW
  DEPARTMENT_CREATE
  DEPARTMENT_UPDATE
  DEPARTMENT_DELETE

  JOB_VIEW
  JOB_CREATE
  JOB_UPDATE
  JOB_PUBLISH
  JOB_ARCHIVE

  APPLICATION_VIEW
  APPLICATION_UPDATE
  APPLICATION_MOVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Candidate {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  phone     String
  location  String?
  education String?
  linkedin  String?
  portfolio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumes      Resume[]
  applications Application[]
}

model Resume {
  id          Int     @id @default(autoincrement())
  candidateId Int
  fileName    String?
  fileKey     String  @unique
  fileType    String
  searchText  String?
  fileSize    Int

  extractedText    String?
  processingStatus ResumeProcessingStatus @default(PENDING)

  name  String?
  email String?
  phone String?

  skills     Json?
  education  Json?
  experience Json?
  projects   Json?

  uploadedAt DateTime @default(now())

  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]
}

enum ResumeProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Application {
  id          Int               @id @default(autoincrement())
  candidateId Int
  jobId       Int
  resumeId    Int
  coverLetter String?
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume    Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  activityLogs  ActivityLog[]
  notifications Notification[]
  interviews    Interview[]

  @@unique([candidateId, jobId])
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

model ActivityLog {
  id            Int                @id @default(autoincrement())
  applicationId Int
  performedById Int
  action        ActivityAction
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  performedBy User        @relation(fields: [performedById], references: [id], onDelete: Restrict)
}

enum ActivityAction {
  STAGE_CHANGED
}

model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int
  applicationId Int?
  type          NotificationType
  message       String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([applicationId])
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STAGE_CHANGED
  APPLICATION_REJECTED
  APPLICATION_OFFER
  APPLICATION_HIRED

  INTERVIEW_EVALUATION_MENTION
}

model Interview {
  id            Int             @id @default(autoincrement())
  applicationId Int
  type          InterviewType
  scheduledAt   DateTime
  duration      Int
  meetingLink   String?
  status        InterviewStatus @default(SCHEDULED)
  createdById   Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  googleEventId String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("InterviewCreatedBy", fields: [createdById], references: [id])

  interviewers InterviewInterviewer[]
}

enum InterviewType {
  SCREENING
  TECHNICAL
  HR
  MANAGERIAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model InterviewInterviewer {
  id          Int @id @default(autoincrement())
  interviewId Int
  userId      Int

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  evaluation InterviewEvaluation?

  @@unique([interviewId, userId])
}

model GoogleCalendarAccount {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  calendarId   String    @default("primary")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  MAYBE
  NO_HIRE
}

model InterviewEvaluation {
  id String @id @default(uuid())

  technicalSkills Int
  problemSolving  Int
  communication   Int
  overall         Int

  recommendation Recommendation
  feedback       String?

  interviewerId Int @unique

  interviewer InterviewInterviewer @relation(fields: [interviewerId], references: [id])

  notes    InterviewEvaluationNote[]
  comments InterviewEvaluationComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewEvaluationNote {
  id           String   @id @default(uuid())
  evaluationId String
  authorId     Int
  note         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evaluation InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model InterviewEvaluationComment {
  id           String @id @default(uuid())
  evaluationId String
  authorId     Int
  content      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions InterviewEvaluationCommentMention[]

  evaluation InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model InterviewEvaluationCommentMention {
  id        String   @id @default(uuid())
  commentId String
  userId    Int
  createdAt DateTime @default(now())

  comment InterviewEvaluationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}
